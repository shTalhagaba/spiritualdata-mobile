{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["app/*"],
      "@components/*": ["app/components/*"],
      "@screens/*": ["app/screens/*"],
      "@assets/*": ["app/assets/*"],
      "@navigation/*": ["app/navigation/*"],
      "@hooks/*": ["app/hooks/*"],
      "@services/*": ["app/services/*"],
      "@utils/*": ["app/utils/*"],
      "@styles/*": ["app/styles/*"],
      "@fonts/*": ["app/assets/fonts/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "app/types/**/*.d.ts"]
}
